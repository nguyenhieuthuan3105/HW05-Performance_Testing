{
  "target": {
    "serverUrl": "${TARGET_URL:-http://localhost:3000}",
    "healthcheckEndpoint": "${HEALTHCHECK_ENDPOINT:-/api/health}"
  },
  "setup": {
    "autoSeed": false,
    "seedScript": "${SEED_SCRIPT:-}"
  },
  "testExecution": {
    "testPlan": "${TEST_PLAN:-test-plans/load_test.jmx}",
    "outputJtl": "test-results/skill_run_results.jtl"
  },
  "qualityGate": {
    "baselineFile": "agent_skills/performance_analyzer/perf_baseline.json",
    "slaMaxP95Ms": 500,
    "slaMaxErrorPercent": 1.0,
    "maxP95RegressionPercent": 15.0
  },
  "reporting": {
    "markdownReport": "reports/perf_summary_report.md"
  }
}
